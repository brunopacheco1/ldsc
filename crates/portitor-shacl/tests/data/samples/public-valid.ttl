# SPDX-License-Identifier: Apache-2.0
#
# A made-up HealthDCAT-AP release 8 dataset with public access. It has no
# violations against the public profile (public-shapes, its recommended
# shapes, range, vocabulary shapes, DCAT-AP 3.0.0 shapes) with the code-list
# sample; it has warnings for recommended properties it leaves out.
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix healthdcatap: <http://healthdataportal.eu/ns/health#> .
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix ex: <https://example.org/> .

ex:dataset-1 a dcat:Dataset ;
    dct:identifier "dataset-1" ;
    dct:title "Example registry extract"@en ;
    dct:description "Synthetic example."@en ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    healthdcatap:healthCategory <https://hdeu-dcat.data.health.europa.eu/resource/authority/healthcategories/HRAD> ;
    healthdcatap:hasStructuredData false ;
    healthdcatap:minTypicalAge "18"^^xsd:nonNegativeInteger ;
    healthdcatap:hdab ex:hdab ;
    dct:publisher ex:publisher ;
    dcat:distribution ex:dist-1 .

ex:dist-1 a dcat:Distribution ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dcat:accessURL <https://example.org/download> .

ex:hdab a foaf:Agent ;
    foaf:name "Example HDAB" ;
    cv:contactPoint ex:hdab-contact .

ex:publisher a foaf:Agent ;
    foaf:name "Example Hospital" ;
    dct:type <https://hdeu-dcat.data.health.europa.eu/resource/authority/publisher-type/healthcare-providers> ;
    cv:contactPoint ex:pub-contact .

ex:hdab-contact a cv:ContactPoint ; cv:email "hdab@example.org" .
ex:pub-contact a cv:ContactPoint ; cv:contactPage <https://example.org/contact> .

# Class memberships that DCAT-AP range.ttl asks for (sh:class); EU code lists
# type their concepts as skos:Concept only.
<http://publications.europa.eu/resource/authority/access-right/PUBLIC> a dct:RightsStatement .
<http://data.europa.eu/eli/reg/2025/327/oj> a eli:LegalResource .
