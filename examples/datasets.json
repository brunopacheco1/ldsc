[
  {
    "@id": "weather-stations",
    "@type": "Dataset",
    "dct:title": "Weather stations",
    "dct:description": "Hourly readings from public weather stations.",
    "dcat:keyword": [
      "weather",
      "open data"
    ],
    "hasPolicy": [
      {
        "@id": "weather-stations:offer:use",
        "@type": "Offer",
        "permission": [
          {
            "action": "use"
          }
        ]
      }
    ],
    "distribution": [
      {
        "@type": "Distribution",
        "format": "HttpData-PULL"
      }
    ]
  },
  {
    "@id": "air-quality",
    "@type": "Dataset",
    "dct:title": "Air quality",
    "dcat:keyword": [
      "air quality"
    ],
    "hasPolicy": [
      {
        "@id": "air-quality:offer:until-2030",
        "@type": "Offer",
        "permission": [
          {
            "action": "use",
            "constraint": [
              {
                "leftOperand": "dateTime",
                "operator": "lteq",
                "rightOperand": "2030-12-31"
              }
            ]
          }
        ]
      }
    ],
    "distribution": [
      {
        "@type": "Distribution",
        "format": "HttpData-PULL"
      }
    ]
  },
  {
    "@id": "member-directory",
    "@type": "Dataset",
    "dct:title": "Member directory",
    "dct:description": "Contacts of the dataspace's members: for members only, and an extended offer for auditors (credential constraints, ADR 0019).",
    "hasPolicy": [
      {
        "@id": "member-directory:offer:members",
        "@type": "Offer",
        "permission": [
          {
            "action": "use",
            "constraint": [
              {
                "leftOperand": "MembershipCredential.memberOf",
                "operator": "eq",
                "rightOperand": "Portitor interop dataspace"
              }
            ]
          }
        ]
      },
      {
        "@id": "member-directory:offer:auditors",
        "@type": "Offer",
        "permission": [
          {
            "action": "use",
            "constraint": [
              {
                "leftOperand": "MembershipCredential.memberOf",
                "operator": "eq",
                "rightOperand": "Portitor interop dataspace"
              },
              {
                "leftOperand": "MembershipCredential.role",
                "operator": "isAnyOf",
                "rightOperand": [
                  "auditor"
                ]
              }
            ]
          }
        ]
      }
    ],
    "distribution": [
      {
        "@type": "Distribution",
        "format": "HttpData-PULL"
      }
    ]
  }
]
