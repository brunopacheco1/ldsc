[
  {
    "@id": "air-quality",
    "@type": "Dataset",
    "portitor:source": "http://data/air-quality.csv",
    "dct:title": "Air quality",
    "dcat:keyword": [
      "air quality"
    ],
    "hasPolicy": [
      {
        "@id": "air-quality:offer:until-2030",
        "@type": "Offer",
        "permission": [
          {
            "action": "use",
            "constraint": [
              {
                "leftOperand": "dateTime",
                "operator": "lteq",
                "rightOperand": "2030-12-31"
              }
            ]
          }
        ]
      }
    ],
    "distribution": [
      {
        "@type": "Distribution",
        "format": "HttpData-PULL"
      }
    ]
  },
  {
    "@id": "member-directory",
    "@type": "Dataset",
    "dct:title": "Member directory",
    "dct:description": "Contacts of the dataspace's members: for members only, and an extended offer for auditors (credential constraints, ADR 0019).",
    "hasPolicy": [
      {
        "@id": "member-directory:offer:members",
        "@type": "Offer",
        "permission": [
          {
            "action": "use",
            "constraint": [
              {
                "leftOperand": "MembershipCredential.memberOf",
                "operator": "eq",
                "rightOperand": "Portitor interop dataspace"
              }
            ]
          }
        ]
      },
      {
        "@id": "member-directory:offer:auditors",
        "@type": "Offer",
        "permission": [
          {
            "action": "use",
            "constraint": [
              {
                "leftOperand": "MembershipCredential.memberOf",
                "operator": "eq",
                "rightOperand": "Portitor interop dataspace"
              },
              {
                "leftOperand": "MembershipCredential.role",
                "operator": "isAnyOf",
                "rightOperand": [
                  "auditor"
                ]
              }
            ]
          }
        ]
      }
    ],
    "distribution": [
      {
        "@type": "Distribution",
        "format": "HttpData-PULL"
      }
    ]
  },
  {
    "@id": "processing-records",
    "portitor:source": "http://data/air-quality.csv",
    "@type": "Dataset",
    "dct:title": "Processing records",
    "dct:description": "Air-quality readings for data processors in the EU: the offer checks a claim of a second credential type, DataProcessorCredential (ADR 0019).",
    "hasPolicy": [
      {
        "@id": "processing-records:offer:eu-processors",
        "@type": "Offer",
        "permission": [
          {
            "action": "use",
            "constraint": [
              {
                "leftOperand": "DataProcessorCredential.processing",
                "operator": "eq",
                "rightOperand": "eu"
              }
            ]
          }
        ]
      }
    ],
    "distribution": [
      {
        "@type": "Distribution",
        "format": "HttpData-PULL"
      }
    ]
  }
]
