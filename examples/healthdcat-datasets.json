    "http://data.europa.eu/r5r/applicableLegislation": {"@id": "http://data.europa.eu/eli/reg/2025/327/oj", "@type": "http://data.europa.eu/eli/ontology#LegalResource"},
    "dcat:theme": {"@id": "http://publications.europa.eu/resource/authority/data-theme/HEAL"},
    "http://healthdataportal.eu/ns/health#healthCategory": {"@id": "https://hdeu-dcat.data.health.europa.eu/resource/authority/healthcategories/HRAD"},
    "http://healthdataportal.eu/ns/health#hasStructuredData": false,
    "http://healthdataportal.eu/ns/health#minTypicalAge": {"@value": "0", "@type": "xsd:nonNegativeInteger"},
