      "@id": "https://hdab.example/", "@type": "http://xmlns.com/foaf/0.1/Agent",
      "http://xmlns.com/foaf/0.1/name": "Example health data access body",
      "http://data.europa.eu/m8g/contactPoint": {"@id": "https://hdab.example/contact", "@type": "http://data.europa.eu/m8g/ContactPoint", "http://data.europa.eu/m8g/email": "access@hdab.example"}
    },
    "dct:publisher": {
      "@id": "https://provider.example/", "@type": "http://xmlns.com/foaf/0.1/Agent",
      "http://xmlns.com/foaf/0.1/name": "Example Hospital",
      "dct:type": {"@id": "https://hdeu-dcat.data.health.europa.eu/resource/authority/publisher-type/healthcare-providers"},
      "http://data.europa.eu/m8g/contactPoint": {"@id": "https://provider.example/contact", "@type": "http://data.europa.eu/m8g/ContactPoint", "http://data.europa.eu/m8g/contactPage": {"@id": "https://provider.example/contact"}}
    },
    "hasPolicy": [
      {
        "@id": "hospital-admissions:offer:until-2030",
        "@type": "Offer",
        "permission": [
          {
            "action": "use",
            "constraint": [
              {
                "leftOperand": "dateTime",
                "operator": "lteq",
                "rightOperand": "2030-12-31"
              }
            ]
          }
        ]
      },
      {
        "@id": "hospital-admissions:offer:eu-processors",
        "@type": "Offer",
        "permission": [
          {
            "action": "use",
            "constraint": [
              {
                "leftOperand": "DataProcessorCredential.processing",
                "operator": "eq",
                "rightOperand": "eu"
              }
            ]
          }
        ]
      }
    ],
    "distribution": [
      {
        "@id": "https://provider.example/datasets/hospital-admissions/csv",
        "@type": "Distribution",
        "format": "HttpData-PULL",
        "http://data.europa.eu/r5r/applicableLegislation": {"@id": "http://data.europa.eu/eli/reg/2025/327/oj"},
        "dcat:accessURL": {"@id": "https://provider.example/datasets/hospital-admissions"}
      }
    ]
  },
