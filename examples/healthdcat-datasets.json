[
  {
    "@id": "https://provider.example/datasets/hospital-admissions",
    "@type": "Dataset",
    "portitor:source": "http://data/hospital-admissions.csv",
    "dct:identifier": "hospital-admissions",
    "dct:title": {"@value": "Hospital admissions per month", "@language": "en"},
    "dct:description": {"@value": "Synthetic counts of hospital admissions per month and region. Made up for the Portitor demo.", "@language": "en"},
