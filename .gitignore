/target
/dist
*.cdx.json

# SQLite files from local runs
*.db
*.db-shm
*.db-wal
__pycache__/

# VS Code: share debug configurations, tasks and recommended extensions;
# keep personal settings (for example lldb.cargo) out of git
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# the Compose demo's generated keys, secrets and authority site
# (scripts/demo-compose.sh writes them)
/examples/compose/run/

# the EDC interop test's generated keys, secrets and authority site
# (scripts/edc-interop.sh writes them), and its Gradle outputs
/interop/edc/run/
/interop/edc/runtimes/**/build/
/interop/edc/runtimes/.gradle/
