// Debug configurations for CodeLLDB (vadimcn.vscode-lldb). See docs/TESTING.md, "Debugging in VS Code".
//
// "cargo" builds the target and starts it under the debugger. Ports and data match
// docs/TESTING.md and the _http/ collection. PORTITOR_* variables are in "cargo.env" on
// purpose: CodeLLDB gives the program Cargo's environment, which overrides "env".
// Databases and the management key go to target/, which git ignores.
//
// Tests: the working directory is the crate, as with `cargo test`. To debug one test,
// use rust-analyzer's "Debug" link above it, or add its name to "args".
// A new file in crates/*/tests gets a configuration here.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Connector (single, :8080, management :8081)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "-p", "portitor-connector", "--bin", "portitor-connector"],
        "env": {
          "RUST_LOG": "info,portitor_connector=debug,portitor_dsp=debug,portitor_dcp=debug",
          "PORTITOR_BIND": "127.0.0.1:8080",
          "PORTITOR_PUBLIC_URL": "http://127.0.0.1:8080",
          "PORTITOR_DATASETS_FILE": "examples/datasets.json",
          "PORTITOR_DB_FILE": "target/vscode-single.db",
          "PORTITOR_MANAGEMENT_API_KEY_FILE": "target/vscode-management.key",
          "PORTITOR_ALLOW_HTTP_CALLBACKS": "true"
        }
      },
      "args": [],
      "presentation": {
        "group": "1-run",
        "order": 1
      },
      "preLaunchTask": "portitor: management key"
    },
    {
      "name": "Connector: provider (:9101)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "-p", "portitor-connector", "--bin", "portitor-connector"],
