          "PORTITOR_BIND": "127.0.0.1:9101",
          "PORTITOR_PUBLIC_URL": "http://127.0.0.1:9101",
          "PORTITOR_PARTICIPANT_ID": "did:web:provider",
          "PORTITOR_DATASETS_FILE": "examples/datasets.json",
          "PORTITOR_DB_FILE": "target/vscode-provider.db",
          "PORTITOR_ALLOW_HTTP_CALLBACKS": "true"
        }
      },
      "args": [],
      "presentation": {
        "group": "1-run",
        "order": 2
      }
    },
    {
      "name": "Connector: consumer (:9201, management :9202)",
      "type": "lldb",
