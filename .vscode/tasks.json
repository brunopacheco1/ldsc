{
  // Shared tasks. Personal settings belong in .vscode/settings.json, which git ignores.
  // "$rustc" comes from the rust-analyzer extension.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo build --workspace",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo test",
      "type": "shell",
      "command": "cargo test --workspace",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo clippy",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo fmt",
      "type": "shell",
      "command": "cargo fmt --all",
      "problemMatcher": []
    },
    {
      // Management API key for the debug configurations. Created once, kept in target/.
      "label": "portitor: management key",
      "type": "shell",
      "command": "mkdir -p target && { test -s target/vscode-management.key || openssl rand -hex 32 > target/vscode-management.key; }",
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    }
  ]
}
