{
  "openapi": "3.1.0",
  "info": {
    "title": "Portitor management API",
    "description": "Starts and follows contract negotiations and transfers in which this connector is the consumer, and shows the dataset harvest jobs (read only). Served on its own port (PORTITOR_MANAGEMENT_BIND), never on the DSP port. Every call except this description needs the API key.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.6.0"
  },
  "paths": {
    "/v1/harvest-jobs": {
      "get": {
        "tags": [
          "Harvest"
        ],
        "summary": "The dataset harvest runs, newest first, a page at a time. The last\n100 runs are kept.",
        "operationId": "list_harvest_jobs",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "description": "Return jobs older than the job with this id.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many to return, 1 to 100 (default 100).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HarvestJobPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/v1/harvest-jobs/{id}": {
      "get": {
        "tags": [
          "Harvest"
        ],
        "summary": "One dataset harvest run, with the entries it rejected and why. A job\nstores at most the first 1000 entry errors, so the answer has no pages.",
        "operationId": "one_harvest_job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The job id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HarvestJobDetail"
                }
              }
            }
          },
          "400": {
            "description": "The id is not a number",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job (or deleted: only the last 100 are kept)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/v1/negotiations": {
      "get": {
        "tags": [
          "Negotiations"
        ],
        "summary": "The negotiations this connector runs as consumer, a page at a time.",
        "operationId": "list",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "description": "Return items whose consumer pid sorts after this one.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many to return, 1 to 100 (default 100).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NegotiationPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      },
      "post": {
        "tags": [
          "Negotiations"
        ],
        "summary": "Start a negotiation as consumer. The request to the provider is sent in\nthe background; follow the negotiation with `GET /v1/negotiations/{consumerPid}`.",
        "operationId": "start",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartNegotiation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Started (state REQUESTED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NegotiationView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/v1/negotiations/{consumerPid}": {
      "get": {
        "tags": [
          "Negotiations"
        ],
        "summary": "One negotiation, with its agreement once the provider sent it.",
        "operationId": "one",
        "parameters": [
          {
            "name": "consumerPid",
            "in": "path",
            "description": "Our process id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The negotiation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NegotiationView"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown negotiation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/v1/transfers": {
      "get": {
        "tags": [
          "Transfers"
        ],
        "summary": "The transfers this connector runs as consumer, a page at a time.",
        "operationId": "list_transfers",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "description": "Return items whose consumer pid sorts after this one.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many to return, 1 to 100 (default 100).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      },
      "post": {
        "tags": [
          "Transfers"
        ],
        "summary": "Request a transfer as consumer, under an agreement from one of our\nnegotiations. The request is sent in the background; follow the\ntransfer with `GET /v1/transfers/{consumerPid}` until it is `STARTED`\nand has a `dataAddress`.",
        "operationId": "start_transfer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartTransfer"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Requested (state REQUESTED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, or no finalized negotiation holds the agreement",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/v1/transfers/{consumerPid}": {
      "get": {
        "tags": [
          "Transfers"
        ],
        "summary": "One transfer, with its data address once the provider started it.",
        "operationId": "one_transfer",
        "parameters": [
          {
            "name": "consumerPid",
            "in": "path",
            "description": "Our process id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The transfer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferView"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown transfer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/v1/transfers/{consumerPid}/completion": {
      "post": {
        "tags": [
          "Transfers"
        ],
        "summary": "Complete a `STARTED` transfer: we have the data and need no more. The\ncompletion is sent in the background.",
        "operationId": "complete_transfer",
        "parameters": [
          {
            "name": "consumerPid",
            "in": "path",
            "description": "Our process id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Completion on its way; the state changes once the provider acknowledges it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferView"
                }
              }
            }
          },
          "400": {
            "description": "The transfer is not STARTED, or a message is still on its way",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown transfer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/v1/transfers/{consumerPid}/termination": {
      "post": {
        "tags": [
          "Transfers"
        ],
        "summary": "End a transfer that has not ended yet. The termination is sent in the\nbackground.",
        "operationId": "terminate_transfer",
        "parameters": [
          {
            "name": "consumerPid",
            "in": "path",
            "description": "Our process id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Termination on its way; the state changes once the provider acknowledges it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferView"
                }
              }
            }
          },
          "400": {
            "description": "The transfer has ended, or a message is still on its way",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown transfer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HarvestCountsView": {
        "type": "object",
        "description": "What a harvest run did, counted.",
        "required": [
          "seen",
          "added",
          "updated",
          "unchanged",
          "withdrawn",
          "rejected"
        ],
        "properties": {
          "added": {
            "type": "integer",
            "format": "int64",
            "description": "Datasets that entered the catalog (new, or back after a withdrawal).",
            "minimum": 0
          },
          "rejected": {
            "type": "integer",
            "format": "int64",
            "description": "Entries that failed a check; the previous version, if any, stays.",
            "minimum": 0
          },
          "seen": {
            "type": "integer",
            "format": "int64",
            "description": "Entries in the snapshot (or stored datasets checked again).",
            "minimum": 0
          },
          "unchanged": {
            "type": "integer",
            "format": "int64",
            "description": "Datasets that passed with the same content.",
            "minimum": 0
          },
          "updated": {
            "type": "integer",
            "format": "int64",
            "description": "Datasets whose content or state changed.",
            "minimum": 0
          },
          "withdrawn": {
            "type": "integer",
            "format": "int64",
            "description": "Datasets no longer in the source: out of the catalog, kept for\ntransfers under agreements already made.",
            "minimum": 0
          }
        }
      },
      "HarvestErrorView": {
        "type": "object",
        "description": "Why one entry was rejected.",
        "required": [
          "check",
          "message"
        ],
        "properties": {
          "check": {
            "type": "string",
            "description": "The check that failed: `json`, `dsp`, `odrl` or `shacl`.",
            "example": "odrl"
          },
          "datasetId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The dataset's `@id`, if it could be read."
          },
          "message": {
            "type": "string",
            "description": "What is wrong."
          },
          "position": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The entry's position in the source, from 0; absent for a stored\ndataset checked again (`bundle` job).",
            "minimum": 0
          },
          "report": {
            "type": [
              "object",
              "null"
            ],
            "description": "The report of the check, for example a SHACL validation report. A\nSHACL report keeps its first 50 results; `resultsNotStored` says\nhow many more there were."
          }
        }
      },
      "HarvestJobDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/HarvestJobView",
            "description": "The job."
          },
          {
            "type": "object",
            "required": [
              "errors"
            ],
            "properties": {
              "errors": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HarvestErrorView"
                },
                "description": "The entries it rejected, in the order it found them: at most the\nfirst 1000 (`counts.rejected` has the total, and the summary says\nwhen some were not stored)."
              }
            }
          }
        ],
        "description": "A harvest job with its entry errors."
      },
      "HarvestJobPage": {
        "type": "object",
        "description": "One page of harvest jobs.",
        "required": [
          "jobs"
        ],
        "properties": {
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HarvestJobView"
            },
            "description": "The jobs, newest first."
          },
          "next": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Pass as `after` to get the next (older) page; absent on the last page.",
            "minimum": 0
          }
        }
      },
      "HarvestJobView": {
        "type": "object",
        "description": "A dataset harvest run.",
        "required": [
          "id",
          "startedAt",
          "finishedAt",
          "trigger",
          "source",
          "outcome",
          "counts",
          "summary"
        ],
        "properties": {
          "counts": {
            "$ref": "#/components/schemas/HarvestCountsView",
            "description": "What the run did."
          },
          "finishedAt": {
            "type": "string",
            "description": "When it ended (UTC)."
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "The job id; a newer job has a higher id.",
            "example": 42,
            "minimum": 0
          },
          "outcome": {
            "type": "string",
            "description": "`succeeded` (nothing rejected), `partial` (some entries rejected),\n`unchanged` (same snapshot as the last run) or `failed` (the source\ncould not be read; the catalog was left as it was).",
            "example": "succeeded"
          },
          "snapshotSha256": {
            "type": [
              "string",
              "null"
            ],
            "description": "SHA-256 of the snapshot, hex; absent when the source failed or for\na `bundle` job."
          },
          "source": {
            "type": "string",
            "description": "The source's name, for example `file:/etc/portitor/datasets.json`."
          },
          "startedAt": {
            "type": "string",
            "description": "When it started (UTC).",
            "example": "2026-11-14T10:00:00Z"
          },
          "summary": {
            "type": "string",
            "description": "One line for people.",
            "example": "3 seen, 1 added, 0 updated, 2 unchanged, 0 withdrawn, 0 rejected"
          },
          "trigger": {
            "type": "string",
            "description": "What started it: `start`, `interval`, or `bundle` (the rules\nchanged, so the stored datasets were checked again).",
            "example": "interval"
          }
        }
      },
      "NegotiationPage": {
        "type": "object",
        "description": "One page of negotiations.",
        "required": [
          "negotiations"
        ],
        "properties": {
          "negotiations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NegotiationView"
            },
            "description": "The negotiations, in consumer pid order."
          },
          "next": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `after` to get the next page; absent on the last page."
          }
        }
      },
      "NegotiationView": {
        "type": "object",
        "description": "A negotiation this connector runs as consumer.",
        "required": [
          "consumerPid",
          "state",
          "providerAddress",
          "providerId",
          "offer"
        ],
        "properties": {
          "agreement": {
            "type": [
              "object",
              "null"
            ],
            "description": "The agreement (DSP 2025-1 `Agreement`), once the provider sent it.\nValid for use once `state` is `FINALIZED`."
          },
          "consumerPid": {
            "type": "string",
            "description": "Our process id."
          },
          "offer": {
            "type": "object",
            "description": "The latest offer (DSP 2025-1 `Offer`)."
          },
          "providerAddress": {
            "type": "string",
            "description": "The provider's DSP endpoint."
          },
          "providerId": {
            "type": "string",
            "description": "The provider's participant id."
          },
          "providerPid": {
            "type": [
              "string",
              "null"
            ],
            "description": "The provider's process id, once it has answered."
          },
          "state": {
            "type": "string",
            "description": "The DSP state, for example `REQUESTED` or `FINALIZED`.",
            "example": "FINALIZED"
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "An error, as RFC 9457 problem details.",
        "required": [
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "What went wrong in this case."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "The HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short summary of the problem type."
          }
        }
      },
      "StartNegotiation": {
        "type": "object",
        "description": "Start a negotiation as consumer.",
        "required": [
          "providerAddress",
          "providerId",
          "offer"
        ],
        "properties": {
          "datasetId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The dataset id. Optional if the offer has a `target`; offers in a\ncatalog have none, as the dataset holds them.",
            "example": "urn:uuid:dataset-1"
          },
          "offer": {
            "type": "object",
            "description": "The offer from the provider's catalog (a DSP 2025-1 `Offer`), copied\nunchanged from the dataset's `hasPolicy`."
          },
          "providerAddress": {
            "type": "string",
            "description": "The provider's DSP endpoint, for example\n`https://provider.example/dsp/2025-1` (the catalog's\n`DataService` `endpointURL`).",
            "example": "https://provider.example/dsp/2025-1"
          },
          "providerId": {
            "type": "string",
            "description": "The provider's participant id (the catalog's `participantId`): a\n`did:web` DID. Our DSP requests are tokens for it, and only it may\nanswer.",
            "example": "did:web:provider.example"
          }
        },
        "additionalProperties": false
      },
      "StartTransfer": {
        "type": "object",
        "description": "Request a transfer as consumer.",
        "required": [
          "agreementId"
        ],
        "properties": {
          "agreementId": {
            "type": "string",
            "description": "The `@id` of the agreement of one of our `FINALIZED` negotiations.\nThe transfer is requested from the provider of that negotiation.",
            "example": "urn:uuid:agreement-1"
          },
          "format": {
            "type": "string",
            "description": "A format of one of the dataset's distributions (default\n`HttpData-PULL`, the only one this connector's data plane serves).",
            "example": "HttpData-PULL"
          }
        },
        "additionalProperties": false
      },
      "TransferPage": {
        "type": "object",
        "description": "One page of transfers.",
        "required": [
          "transfers"
        ],
        "properties": {
          "next": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `after` to get the next page; absent on the last page."
          },
          "transfers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferView"
            },
            "description": "The transfers, in consumer pid order."
          }
        }
      },
      "TransferView": {
        "type": "object",
        "description": "A transfer this connector runs as consumer.",
        "required": [
          "consumerPid",
          "state",
          "providerAddress",
          "providerId",
          "agreementId",
          "format"
        ],
        "properties": {
          "agreementId": {
            "type": "string",
            "description": "The agreement the transfer is made under."
          },
          "consumerPid": {
            "type": "string",
            "description": "Our process id."
          },
          "dataAddress": {
            "type": [
              "object",
              "null"
            ],
            "description": "Where to fetch the data, with the access token (DSP 2025-1\n`DataAddress`): send `GET <endpoint>` with `Authorization: <the\nauthorization property>`. Present while the transfer is `STARTED`\nor `SUSPENDED`; the token works only while it is `STARTED`."
          },
          "format": {
            "type": "string",
            "description": "The format asked for."
          },
          "providerAddress": {
            "type": "string",
            "description": "The provider's DSP endpoint."
          },
          "providerId": {
            "type": "string",
            "description": "The provider's participant id."
          },
          "providerPid": {
            "type": [
              "string",
              "null"
            ],
            "description": "The provider's process id, once it has answered."
          },
          "state": {
            "type": "string",
            "description": "The DSP state, for example `REQUESTED` or `STARTED`.",
            "example": "STARTED"
          }
        }
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "http",
        "scheme": "bearer",
        "description": "The key from PORTITOR_MANAGEMENT_API_KEY_FILE: Authorization: Bearer <key>"
      }
    }
  },
  "tags": [
    {
      "name": "Negotiations",
      "description": "Contract negotiations as consumer (DSP 2025-1)"
    },
    {
      "name": "Transfers",
      "description": "Transfer processes as consumer (DSP 2025-1), pull only"
    },
    {
      "name": "Harvest",
      "description": "Dataset harvest runs: datasets come from the source into the catalog (ADR 0020). Read only."
    }
  ]
}
