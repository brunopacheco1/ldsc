          }
        },
        "responses": {
          "200": {
            "description": "Accepted (state ACCEPTED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid message or transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-error-schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Unknown negotiation (also answered for another consumer's negotiation)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-error-schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/dsp/2025-1/negotiations/{providerPid}/agreement/verification": {
      "post": {
        "tags": [
          "Contract negotiation (provider)"
        ],
        "summary": "Consumer verifies the agreement",
        "operationId": "negotiationVerification",
        "parameters": [
          {
            "name": "providerPid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The provider's id for the negotiation"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-agreement-verification-message-schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted (state VERIFIED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid message or transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-error-schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Unknown negotiation (also answered for another consumer's negotiation)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-error-schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/dsp/2025-1/negotiations/{providerPid}/termination": {
      "post": {
        "tags": [
          "Contract negotiation (provider)"
        ],
        "summary": "Consumer ends the negotiation",
        "operationId": "negotiationTermination",
        "parameters": [
          {
            "name": "providerPid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The provider's id for the negotiation"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-termination-message-schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted (state TERMINATED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid message or transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-error-schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Unknown negotiation (also answered for another consumer's negotiation)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-error-schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/dsp/2025-1/callback/negotiations/{consumerPid}": {
      "get": {
        "tags": [
          "Contract negotiation (consumer callback)"
        ],
        "summary": "Return the state of a negotiation this connector started as consumer",
        "operationId": "consumerNegotiation",
        "parameters": [
          {
            "name": "consumerPid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The consumer's id for the negotiation"
          }
        ],
        "responses": {
          "200": {
            "description": "The negotiation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Unknown negotiation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-error-schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/dsp/2025-1/callback/negotiations/{consumerPid}/offers": {
      "post": {
        "tags": [
          "Contract negotiation (consumer callback)"
        ],
        "summary": "Provider sends an offer",
        "operationId": "consumerOffer",
        "parameters": [
          {
            "name": "consumerPid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The consumer's id for the negotiation"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-offer-message-schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Offer recorded (state OFFERED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid message, or it does not fit the state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-error-schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Unknown negotiation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-error-schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/dsp/2025-1/callback/negotiations/{consumerPid}/agreement": {
      "post": {
        "tags": [
          "Contract negotiation (consumer callback)"
        ],
        "summary": "Provider sends the agreement",
        "operationId": "consumerAgreement",
        "parameters": [
          {
            "name": "consumerPid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The consumer's id for the negotiation"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-agreement-message-schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agreement recorded (state AGREED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid message, or it does not fit the state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-error-schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Unknown negotiation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-error-schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/dsp/2025-1/callback/negotiations/{consumerPid}/events": {
      "post": {
        "tags": [
          "Contract negotiation (consumer callback)"
        ],
        "summary": "Provider finalizes the negotiation",
        "operationId": "consumerEvent",
        "parameters": [
          {
            "name": "consumerPid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The consumer's id for the negotiation"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../crates/ldsc-dsp/tests/schemas/contract-negotiation-event-message-schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Finalized (state FINALIZED)",
