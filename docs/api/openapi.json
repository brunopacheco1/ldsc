      }
    },
    "/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Liveness",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The process runs",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "const": "ok"
                }
              }
            }
          }
        }
      }
    }
  }
}
