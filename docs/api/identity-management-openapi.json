{
  "openapi": "3.1.0",
  "info": {
    "title": "Portitor identity management API",
    "description": "Credential requests, credentials and offers of the participant this identity component holds. Served on its own port (PORTITOR_MANAGEMENT_BIND), never on the public port. Every call except this description needs the API key.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.5.0"
  },
  "paths": {
    "/v1/credential-requests": {
      "get": {
        "tags": [
          "Credentials"
        ],
        "summary": "List the credential requests, newest first, with their local state.",
        "operationId": "list_requests",
        "responses": {
          "200": {
            "description": "The requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RequestView"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      },
      "post": {
        "tags": [
          "Credentials"
        ],
        "summary": "Create a credential request. With `credentialIds`, ask the issuer for\nthose credentials (DCP 6.4): the identity component finds the issuer's\n`IssuerService` in its DID document, checks the ids against its\nmetadata, records the request and sends it, with an access token the\nissuer must send back with its delivery. Without `credentialIds`, only\nrecord the request, so that the Storage API accepts the delivery of an\nissuer asked out of band (DCP 6.5).",
        "operationId": "create_request",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Sent to the issuer, or recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestCreated"
                }
              }
            }
          },
          "202": {
            "description": "Sent, but the issuer's answer is unknown (no answer in time, or a server error): the request stays open, so its delivery is accepted; `sendError` says why",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestCreated"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, the issuer is not trusted, or it does not offer a credential asked for",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "A request with this holderPid exists",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "The issuer refused the request (HTTP 4xx); nothing is kept",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/v1/credential-requests/{holderPid}": {
      "get": {
        "tags": [
          "Credentials"
        ],
        "summary": "Read a credential request: its local state, and its status at the\nissuer (DCP 6.8), read now from the issuer's status URL. If the\nissuer cannot be read, `issuerStatusError` says why.",
        "operationId": "get_request",
        "parameters": [
          {
            "name": "holderPid",
            "in": "path",
            "description": "The holder's id for the request",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestView"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/v1/credentials": {
      "get": {
        "tags": [
          "Credentials"
        ],
        "summary": "List the credentials the participant holds.",
        "operationId": "list_credentials",
        "responses": {
          "200": {
            "description": "The credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CredentialView"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/v1/credentials/{id}": {
      "delete": {
        "tags": [
          "Credentials"
        ],
        "summary": "Delete a credential: it is no longer presented.",
        "operationId": "delete_credential",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The credential's id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such credential",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/v1/offers": {
      "get": {
        "tags": [
          "Credentials"
        ],
        "summary": "List the credentials issuers offered, newest first.",
        "operationId": "list_offers",
        "responses": {
          "200": {
            "description": "The offers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OfferView"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/v1/offers/request": {
      "post": {
        "tags": [
          "Credentials"
        ],
        "summary": "Ask an issuer for credentials it offered (DCP 6.6): a credential\nrequest (as `POST /v1/credential-requests` with `credentialIds`) for\nthe offered ids. An offer is never answered by itself; the operator\ndecides here. The offer stays listed.",
        "operationId": "request_offered",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Sent to the issuer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestCreated"
                }
              }
            }
          },
          "202": {
            "description": "Sent, but the issuer's answer is unknown: the request stays open; `sendError` says why",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestCreated"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, the issuer is not trusted, or it does not offer a credential asked for",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such offer from this issuer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "The issuer refused the request (HTTP 4xx); nothing is kept",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CredentialView": {
        "type": "object",
        "description": "A credential the participant holds.",
        "required": [
          "id",
          "types",
          "issuer",
          "profile"
        ],
        "properties": {
          "expiry": {
            "type": [
              "string",
              "null"
            ],
            "description": "When it expires (`xsd:dateTime`, UTC), or null if it does not.",
            "example": "2027-11-13T12:00:00Z"
          },
          "id": {
            "type": "string",
            "description": "The credential's id.",
            "example": "urn:uuid:8247b87d-8d72-47e1-8128-9ce47e3d829d"
          },
          "issuer": {
            "type": "string",
            "description": "The issuer's DID.",
            "example": "did:web:issuer.example"
          },
          "profile": {
            "type": "string",
            "description": "The DCP profile: `vc11-sl2021/jwt` or `vc20-bssl/jwt`.",
            "example": "vc11-sl2021/jwt"
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Its types.",
            "example": [
              "VerifiableCredential",
              "MembershipCredential"
            ]
          }
        }
      },
      "IssuerStatusView": {
        "type": "object",
        "description": "A request's status at the issuer (DCP 6.8, `CredentialStatus`).",
        "required": [
          "issuerPid",
          "status"
        ],
        "properties": {
          "issuerPid": {
            "type": "string",
            "description": "The issuer's id for the request."
          },
          "status": {
            "type": "string",
            "description": "`RECEIVED`, `ISSUED` or `REJECTED`.",
            "example": "ISSUED"
          }
        }
      },
      "NewRequest": {
        "type": "object",
        "description": "A new credential request.",
        "required": [
          "issuerDid"
        ],
        "properties": {
          "credentialIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the credentials to ask for, from the issuer's metadata\n(`credentialsSupported`, DCP 6.7). With ids, the identity component\nsends the request to the issuer (DCP 6.4). Without, it only records\nthe request, for an issuer that is asked out of band.",
            "example": [
              "membership-vc11"
            ]
          },
          "holderPid": {
            "type": [
              "string",
              "null"
            ],
            "description": "The holder's id for the request, which the issuer sends back as\n`holderPid` in its `CredentialMessage`. A new id if left out.",
            "example": "urn:uuid:5f7a3c1e-0d2b-4c6e-9a8f-1b2c3d4e5f60"
          },
          "issuerDid": {
            "type": "string",
            "description": "The issuer that will deliver the credentials; one of\n`PORTITOR_TRUSTED_ISSUERS`.",
            "example": "did:web:issuer.example"
          }
        },
        "additionalProperties": false
      },
      "OfferView": {
        "type": "object",
        "description": "A credential an issuer offered (DCP 6.6).",
        "required": [
          "issuer",
          "id",
          "received"
        ],
        "properties": {
          "credentialType": {
            "type": [
              "string",
              "null"
            ],
            "description": "The credential type, if the issuer said.",
            "example": "MembershipCredential"
          },
          "id": {
            "type": "string",
            "description": "The offered credential's id in the issuer's metadata."
          },
          "issuer": {
            "type": "string",
            "description": "The issuer's DID.",
            "example": "did:web:issuer.example"
          },
          "offerReason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why it is offered, for example `reissue`."
          },
          "profile": {
            "type": [
              "string",
              "null"
            ],
            "description": "The DCP profile, if the issuer said."
          },
          "received": {
            "type": "string",
            "description": "When the offer arrived (`xsd:dateTime`, UTC)."
          }
        }
      },
      "OfferedRequest": {
        "type": "object",
        "description": "Ask an issuer for what it offered (DCP 6.6).",
        "required": [
          "issuerDid"
        ],
        "properties": {
          "credentialIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The offered credential ids to ask for; every credential the issuer\noffered if left out."
          },
          "issuerDid": {
            "type": "string",
            "description": "The issuer that sent the offer.",
            "example": "did:web:issuer.example"
          }
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "description": "An error, as RFC 9457 problem details.",
        "required": [
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "What went wrong in this case."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "The HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short summary of the problem type."
          }
        }
      },
      "RequestCreated": {
        "type": "object",
        "description": "A recorded credential request.",
        "required": [
          "holderPid"
        ],
        "properties": {
          "holderPid": {
            "type": "string",
            "description": "The holder's id for the request."
          },
          "sendError": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the issuer's answer is not known (`202 Accepted` only): the\nissuer may have taken the request, so it stays open and its\ndelivery is accepted.",
            "example": "no answer within 10s"
          },
          "statusUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the issuer serves the request's status (DCP 6.8), when the\nrequest was sent and the issuer gave one."
          }
        }
      },
      "RequestView": {
        "type": "object",
        "description": "A credential request and where it stands.",
        "required": [
          "holderPid",
          "issuerDid",
          "status",
          "credentialIds"
        ],
        "properties": {
          "created": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the request was made (`xsd:dateTime`, UTC); absent for\nrequests recorded before 0.6."
          },
          "credentialIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The credential ids asked for; empty for a request only recorded."
          },
          "holderPid": {
            "type": "string",
            "description": "The holder's id for the request."
          },
          "issuerDid": {
            "type": "string",
            "description": "The issuer that may answer it.",
            "example": "did:web:issuer.example"
          },
          "issuerPid": {
            "type": [
              "string",
              "null"
            ],
            "description": "The issuer's id of the request, from its delivery."
          },
          "issuerStatus": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/IssuerStatusView",
                "description": "The issuer's view (`CredentialStatus`, DCP 6.8). Only when one\nrequest is read and the issuer answered."
              },
              {
                "type": "null"
              }
            ]
          },
          "issuerStatusError": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the issuer's view could not be read. Only when one request is\nread."
          },
          "sendError": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the issuer's answer to the request is not known (no answer in\ntime, or a server error). The request stays `REQUESTED`, so a\nlate delivery is accepted."
          },
          "status": {
            "type": "string",
            "description": "The local state: `REQUESTED` until the issuer delivers, then\n`ISSUED` or `REJECTED`.",
            "example": "REQUESTED"
          },
          "statusUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the issuer serves the request's status (DCP 6.8), if known."
          }
        }
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "http",
        "scheme": "bearer",
        "description": "The key from PORTITOR_MANAGEMENT_API_KEY_FILE: Authorization: Bearer <key>"
      }
    }
  },
  "tags": [
    {
      "name": "Credentials",
      "description": "The participant's verifiable credentials (DCP v1.0.1)"
    }
  ]
}
